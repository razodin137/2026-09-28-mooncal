# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global core.excludesFile.
# See https://git-scm.com/docs/gitignore for more about ignoring files.

# Ignore bundler config.
/.bundle
/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore Ruby version managers.
/.rbenv
/.ruby-version.local

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore storage files.
/storage/*
!/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-*
/config/master.key

# Ignore production credentials.
/config/credentials/production.key

# Ignore node-specific ignores.
/node_modules